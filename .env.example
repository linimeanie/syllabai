# Copy to .env.local for local dev, or set in Vercel project settings.
# Without ANY key, the app still runs and shows the baked-in SBF sample course.

# --- Option A: Groq (free tier, no card) — used if set ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option B: Anthropic Claude (used only if no Groq key) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
